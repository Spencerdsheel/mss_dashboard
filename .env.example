# Local development environment template.
# Copy to .env (`cp .env.example .env`) and adjust as needed.
# The backend loads this via python-dotenv (services/common/settings.py);
# Next.js loads the same file for its server-side vars (BACKEND_API_URL, DATA_PROVIDER).

# --- App / backend ---
APP_ENV=development
BACKEND_REPOSITORY=postgres

# Postgres stays on host port 5433 (db shopmetrics_demo, user postgres, password admin).
DATABASE_URL=postgresql://postgres:admin@localhost:5433/shopmetrics_demo

# Redis on host port 6380 (broker + cache + rate limiter + JWT revocation).
REDIS_URL=redis://localhost:6380/0

# Auth / secrets — dev-only defaults; production MUST override these with strong values.
JWT_SECRET=dev-only-change-me
SECRET_ENCRYPTION_KEY=dev-only-secret-encryption-key

# Scheduled data refresh cadence (minutes). 360 = every 6 hours.
SCHEDULED_REFRESH_INTERVAL_MINUTES=360

# CORS allowlist for the API (comma-separated frontend origins).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Frontend (server-side) ---
BACKEND_API_URL=http://localhost:8010
DATA_PROVIDER=rest-api
